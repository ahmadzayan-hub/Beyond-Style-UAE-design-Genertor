# Copy to .env (never commit real secrets).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/beyondstyle

# --- Claude (base reasoning/design intelligence) ---
# Absent by default: code must run (and tests must pass) with none of this set.
ANTHROPIC_API_KEY=
PRIMARY_REASONING_MODEL=claude-sonnet-5
FAST_LOW_COST_MODEL=claude-haiku-4-5
EXPERT_ESCALATION_MODEL=claude-opus-5

# --- Hermes orchestration runtime ---
# "enabled" only toggles the in-process adapter's reported intent; actual
# execution mode is auto-detected (hermes package present vs in-process).
HERMES_RUNTIME=enabled
MAX_AGENT_DEPTH=3
MAX_AGENT_CALLS_PER_JOB=12
MAX_TOOL_CALLS_PER_JOB=40
MAX_AI_COST_PER_JOB=1.50
MAX_AI_COST_PER_SESSION=5.00
AGENT_TIMEOUT_S=90
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2

# --- OpenAI GPT-Image-2 (visualization only, never manufacturing truth) ---
# Disabled by default; the deterministic SVG/DXF path never depends on this.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_ENABLED=false
OPENAI_IMAGE_PROVIDER=gpt-image-2
IMAGE_TIMEOUT_S=180
