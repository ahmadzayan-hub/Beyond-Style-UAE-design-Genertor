# Copy to .env.local for local dev (never commit real values).
#
# PRODUCTION (Vercel): set NEXT_PUBLIC_API_URL to the real, publicly
# reachable backend origin (e.g. the Replit deployment URL). The
# browser fetches this origin DIRECTLY — CORS, not a Vercel-side proxy
# — so the backend's ALLOWED_ORIGINS must include this site's origin.
# See docs/DEPLOYMENT.md.
#
# LOCAL DEV: leave NEXT_PUBLIC_API_URL unset. lib/api.ts then uses
# relative "/api/..." paths, proxied by next.config.mjs's rewrite to
# BACKEND_URL (below) — a dev convenience only, not how production works.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_ENV=production

# Local dev only (see next.config.mjs) — never used in production.
BACKEND_URL=http://localhost:8000

# NEVER add ANTHROPIC_API_KEY / OPENAI_API_KEY / any server-side secret
# here. This app has no Next.js API routes that execute server-side
# code needing them — every NEXT_PUBLIC_* value is bundled into the
# browser JS. See docs/DEPLOYMENT.md "Secret leak prevention".
